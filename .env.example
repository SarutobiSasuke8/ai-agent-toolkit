OPENAI_API_KEY=your_api_key_here

# Nous Research (Hermes models) over their OpenAI-compatible API.
# NOUS_BASE_URL is optional. Override it to reuse the same code path
# against any other OpenAI-compatible host.
NOUS_API_KEY=your_nous_api_key_here
NOUS_BASE_URL=https://inference-api.nousresearch.com/v1

AI_AGENT_PROVIDER=ollama
AI_AGENT_MODEL=llama3.2:1b
